// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  apiKey       String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Job {
  id          String   @id @default(cuid())
  name        String
  description String?
  schedule    String   // Cron expression
  type        String   // "shell" | "http" | "docker"
  config      String   // JSON string for type-specific config
  status      String   @default("active") // "active" | "paused"
  tags        String   @default("[]") // JSON array of tags
  timeout     Int      @default(300000) // Timeout in ms (default 5 min)
  retryPolicy String   @default("{}") // JSON: { maxRetries, backoff, delayMs }
  envVars     String   @default("{}") // JSON object of env vars
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions Execution[]

  @@index([status])
  @@index([createdAt])
}

model Execution {
  id         String    @id @default(cuid())
  jobId      String
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  exitCode   Int?
  trigger    String    @default("scheduled") // "scheduled" | "manual" | "retry"
  status     String    @default("running") // "running" | "success" | "failed" | "timeout"

  logs Log[]

  @@index([jobId])
  @@index([status])
  @@index([startedAt])
}

model Log {
  id          String    @id @default(cuid())
  executionId String
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  stream      String    // "stdout" | "stderr"
  content     String
  createdAt   DateTime  @default(now())

  @@index([executionId])
}

model Notification {
  id        String   @id @default(cuid())
  name      String
  type      String   // "webhook" | "email"
  config    String   // JSON: { url, headers } for webhook, { to, subject } for email
  events    String   @default("[\"job_failed\"]") // JSON array: "job_failed" | "job_timeout" | "job_recovered"
  jobIds    String   @default("[]") // JSON array of job IDs (empty = all jobs)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String // JSON value

  @@index([key])
}
